---
import fs from 'node:fs';
import path from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const albumConfig: Record<string, { prefix: string; label: string }> = {
  'details':      { prefix: 'wedding-details',   label: 'Details' },
  'pre-ceremony': { prefix: 'wedding-pre',        label: 'Pre-Ceremony' },
  'portraits':    { prefix: 'wedding-portraits',  label: 'Portraits' },
  'formals':      { prefix: 'wedding-formals',    label: 'Formals' },
  'ceremony':     { prefix: 'wedding-ceremony',   label: 'Ceremony' },
  'reception':    { prefix: 'wedding-reception',  label: 'Reception' },
  'vendors':      { prefix: 'wedding-vendors',    label: 'Vendors' },
};

export function getStaticPaths() {
  const albums = ['details', 'pre-ceremony', 'portraits', 'formals', 'ceremony', 'reception', 'vendors'];
  return albums.map(album => ({ params: { album } }));
}

const { album } = Astro.params;
const config = albumConfig[album];

const imagesDir = path.join(process.cwd(), 'public', 'images');
const photos = fs.readdirSync(imagesDir)
  .filter(f => f.startsWith(`${config.prefix}-`) && f.endsWith('.webp'))
  .sort((a, b) => {
    const numA = parseInt(a.match(/-(\d+)\.webp$/)?.[1] ?? '0');
    const numB = parseInt(b.match(/-(\d+)\.webp$/)?.[1] ?? '0');
    return numA - numB;
  })
  .map(f => `/images/${f}`);
---

<html lang="en">
  <head>
    <BaseHead
      title={`${config.label} — Kristen & Skyler's Wedding | Mohr Leisure`}
      description={`${config.label} photos from Kristen & Skyler Mohr's wedding at The Hall on Dragon, Dallas.`}
      image={photos[0]}
    />
    <style>
      .album-header {
        text-align: center;
        padding: 2.5em 1em 1.5em;
        border-bottom: 1px solid rgb(var(--gray-light));
      }
      .album-header .back {
        display: inline-block;
        font-size: 0.85em;
        color: rgb(var(--gray));
        text-decoration: none;
        margin-bottom: 0.75em;
      }
      .album-header .back:hover { color: var(--accent); }
      .album-header h1 {
        margin: 0 0 0.2em;
        font-size: 2.2rem;
      }
      .album-header p {
        color: rgb(var(--gray));
        margin: 0;
        font-size: 0.9em;
      }
      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.4em;
        padding: 1em;
        max-width: 1200px;
        margin: 0 auto;
      }
      @media (max-width: 720px) {
        .gallery-grid { grid-template-columns: repeat(2, 1fr); }
      }
      @media (max-width: 480px) {
        .gallery-grid { grid-template-columns: 1fr; }
      }
      .gallery-grid button {
        all: unset;
        cursor: zoom-in;
        display: block;
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 6px;
        background: rgb(var(--gray-light));
      }
      .gallery-grid button img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.2s;
        border-radius: 6px;
      }
      .gallery-grid button:hover img { transform: scale(1.03); }
      .lightbox {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.94);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        cursor: zoom-out;
      }
      .lightbox.open { display: flex; }
      .lightbox img {
        max-width: 92vw;
        max-height: 92vh;
        object-fit: contain;
        border-radius: 4px;
      }
      .lightbox-close {
        position: absolute;
        top: 1.2em;
        right: 1.4em;
        color: white;
        font-size: 2rem;
        line-height: 1;
        cursor: pointer;
        background: none;
        border: none;
        opacity: 0.8;
      }
      .lightbox-close:hover { opacity: 1; }
      .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        border: none;
        color: white;
        font-size: 2rem;
        padding: 0.3em 0.6em;
        cursor: pointer;
        border-radius: 6px;
        line-height: 1;
      }
      .lightbox-nav:hover { background: rgba(255,255,255,0.25); }
      .lightbox-prev { left: 1em; }
      .lightbox-next { right: 1em; }
      .lightbox-counter {
        position: absolute;
        bottom: 1.2em;
        left: 50%;
        transform: translateX(-50%);
        color: rgba(255,255,255,0.6);
        font-size: 0.85em;
      }
    </style>
  </head>
  <body>
    <Header />
    <div class="album-header">
      <a class="back" href="/reviews/mohr-wedding/">← Back to the wedding</a>
      <h1>{config.label}</h1>
      <p>Kristen & Skyler Mohr · The Hall on Dragon, Dallas · August 28, 2026 · {photos.length} photos</p>
    </div>

    <div class="gallery-grid">
      {photos.map((src, i) => (
        <button class="gallery-thumb" data-src={src} data-index={i} aria-label={`Photo ${i + 1}`}>
          <img src={src} alt={`${config.label} photo ${i + 1}`} loading="lazy" />
        </button>
      ))}
    </div>

    <Footer />

    <div class="lightbox" id="lightbox">
      <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
      <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous">&#8249;</button>
      <img id="lightbox-img" src="" alt="" />
      <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next">&#8250;</button>
      <div class="lightbox-counter" id="lightbox-counter"></div>
    </div>

    <script>
      const photos = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-thumb'))
        .map(btn => btn.dataset.src ?? '');
      let current = 0;

      const lightbox = document.getElementById('lightbox') as HTMLElement;
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const counter = document.getElementById('lightbox-counter') as HTMLElement;

      function openAt(index: number) {
        current = index;
        lightboxImg.src = photos[current];
        counter.textContent = `${current + 1} / ${photos.length}`;
        lightbox.classList.add('open');
      }

      function closeLightbox() { lightbox.classList.remove('open'); }

      document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach((btn, i) => {
        btn.addEventListener('click', () => openAt(i));
      });

      document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
      document.getElementById('lightbox-prev')?.addEventListener('click', (e) => {
        e.stopPropagation();
        openAt((current - 1 + photos.length) % photos.length);
      });
      document.getElementById('lightbox-next')?.addEventListener('click', (e) => {
        e.stopPropagation();
        openAt((current + 1) % photos.length);
      });
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') openAt((current - 1 + photos.length) % photos.length);
        if (e.key === 'ArrowRight') openAt((current + 1) % photos.length);
      });
    </script>
  </body>
</html>
